{
  "name": "@statewalker/inline.view.react",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Inline-content renderer fragment.",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fragment": {
      "source": "./src/fragment.ts",
      "types": "./dist/fragment.d.ts",
      "import": "./dist/fragment.js",
      "default": "./dist/fragment.js"
    },
    "./styles": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "tsdown"
  },
  "dependencies": {
    "@statewalker/ui.view.react": "workspace:^",
    "@statewalker/mime.core": "catalog:",
    "@statewalker/inline.core": "catalog:",
    "@statewalker/shared-commands": "catalog:",
    "@statewalker/shared-registry": "catalog:",
    "@statewalker/shared-slots": "catalog:",
    "@statewalker/workspace.core": "catalog:",
    "@statewalker/workspace.view.react": "workspace:^"
  },
  "peerDependencies": {
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
