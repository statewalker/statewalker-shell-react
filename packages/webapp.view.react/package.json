{
  "name": "@statewalker/webapp.view.react",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Web-app dock renderer fragment: the <SiteFrame> catalog component (an iframe pointed at the hosted client) registered into the shell's json:catalogs slot for JsonPanel to render.",
  "homepage": "https://github.com/statewalker/statewalker-workbench",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/statewalker-workbench.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./fragment": "./src/fragment.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@json-render/core": "catalog:",
    "@statewalker/render.core": "catalog:",
    "@statewalker/render.view.react": "workspace:*",
    "@statewalker/shared-registry": "catalog:",
    "@statewalker/shared-slots": "catalog:",
    "@statewalker/shell.view.react": "workspace:*",
    "@statewalker/webapp.browser": "catalog:",
    "@statewalker/workspace.core": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
